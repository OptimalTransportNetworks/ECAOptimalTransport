@article{LGEAW,
 title = {Local GDP Estimates Around the World},
 author = {Rossi-Hansberg, Esteban and Zhang, Jialing},
 institution = {},
 type = {Working Paper},
 series = {Working Paper Series},
 number = {},
 year={2025},
 month = {January},
 doi = {},
 url = {},
 abstract = {We use a variety of high-resolution spatial data to build a novel global annual gridded GDP dataset at 1°, 0.5°, and 0.25° resolutions from 2012 onward. We train a random forest model using local GDP (when available) and national GDP measures. Our model achieves an $R^2$ above 0.92 for GDP levels and above 0.62 for annual changes in local GDP prediction for regions left out of the training sample. By incorporating diverse high-resolution indicators beyond population and nighttime lights, our estimates offer more precise subnational GDP measurements that can be used to analyze economic shocks, local policy impacts, and regional disparities. We evaluate the precision of our estimates using a sample case for the impact of COVID-19 on local GDP in China.}
}

